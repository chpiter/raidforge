# REFERENCE ONLY - this file is not installed and must NOT be copied to /opt.
#
# The image's real factory config is a heredoc inside
# config/hooks/live/010-install-app.hook.chroot (lines 111-136); that hook
# regenerates /etc/raidforge/config.yaml on every build.  Copying this file to
# /opt/raidforge/config.yaml would replace the symlink to /etc and split the
# configuration in two.
#
# Where each value belongs:
#   factory defaults (permanent)  -> the hook's heredoc, then rebuild the ISO
#   site overrides (this boot)    -> /etc/raidforge/config.d/*.yaml (TUI writes
#                                   90-site.yaml; use 99-site.yaml to win)
#   debugging / automation        -> RAIDFORGE_* env vars, or --set on the command line
#
# Precedence (low -> high): compiled defaults < /etc/raidforge/config.yaml
# < config.d/*.yaml (name order) < --config < RAIDFORGE_* env vars < --set overrides.
# Everything below is optional - these are the values a site usually sets.

dry_run: false

app_name: "raidforge"
app_version: "1.1.0"

ui:
  # Deep blue is the default on every terminal.  Monochrome is only used when
  # explicitly selected here (or with RAIDFORGE_THEME=mono /
  # RAIDFORGE_MONO=1); TERM=linux no longer switches the palette.
  theme: "raidforge"          # auto | raidforge | raidforge-mono

  # Deprecated colour keys are accepted for backwards compatibility and ignored.
  # background: "#002B49"
  # foreground: "#E6F4FA"
  # accent: "#4FC3F7"
  # danger: "#FF5252"
  # ok: "#66BB6A"

  # Still honoured: how often the status bar refreshes.
  refresh_interval: 1.0

tools:
  detect_timeout: 20
  enum_timeout: 30
  # Constraint 12: never wait more than 60s for a submit.
  command_timeout: 60
  detection_order: ["storcli", "perccli", "arcconf", "ssacli", "sg3_utils"]
  forced_tool: null          # e.g. "storcli" to skip the ladder
  enable_nvme: true
  vendor_bin_dir: "/usr/local/bin"
  default_hdd_method: "thorough"
  default_ssd_method: null   # null => sanitize when SED capable, else blockerase

raid:
  # Stripe: null = controller default (no strip/stripesize/ss option emitted).
  # Set a positive KB value to force an explicit stripe on every level.
  stripe_kb: null
  # fast = request fast initialisation where the vendor exposes an option;
  # none = emit no initialisation option (controller default). LSI always
  # uses the controller default fast init.
  init: "fast"
  command_timeout: 120
  allow_clear_config: true
  name_max_len: 15

evidence:
  root: "/var/log/raidforge-evidence"
  record_session: true
  recorder: "asciinema"
  recorder_options: ["--overwrite", "--quiet"]
  snapshot_on_screen_change: true

report:
  enabled: true
  # Constraint 10: cap the wait for a network address.
  wait_for_route_seconds: 30
  # Preferred upload channel: "ssh" or "http".  The other one is still tried
  # as a fallback before the session is queued locally.
  transport: "ssh"
  # Factory default; change at runtime from the TUI (Dashboard -> S).
  ssh_host: "192.168.40.129"
  # ssh_user / ssh_key_path / ssh_remote_root are fixed in the shipped image
  # and shown read-only in the TUI.  SSH/HTTP ports are editable there.
  ssh_user: "evidence"
  ssh_port: 22
  ssh_key_path: "/etc/raidforge/keys/evidence_ed25519"
  ssh_remote_root: "/srv/evidence/incoming"
  ssh_extra_opts: ["-o", "StrictHostKeyChecking=no", "-o", "BatchMode=yes"]
  # HTTP evidence receiver.  Empty host + transport=http follows webplane.
  http_host: ""
  # Explicit full URL wins; leave empty (the TUI clears its legacy derived value).
  http_base_url: ""
  http_port: 8080
  http_timeout: 30
  # Best-effort upload after each erase run (TUI stays live); failures are not
  # copied into pending/ here, the final exit upload owns queueing.
  run_upload_seconds: 30
  pending_root: "/var/lib/raidforge/pending"
  uploaded_root: "/var/lib/raidforge/uploaded"

# Control plane endpoint; an empty host inherits /etc/raidforge/agent.yaml.
webplane:
  host: ""
  port: 8080
  scheme: "http"
  api_prefix: "/api/raidforge"
