#!/bin/sh
#
# lb config driver.  Called by `lb config`; see live-build(7).
#
# Disk: debian bookworm, amd64 only, hybrid ISO with both BIOS (syslinux/isolinux)
# and UEFI (grub-efi) boot paths so the image boots on legacy servers and on
# modern ones.
#
set -e

DISTRO="${DISTRO:-bookworm}"
ARCH="${ARCH:-amd64}"

# syslinux has no arm64 port: arm64 images boot through UEFI/GRUB only.
BOOTLOADERS="syslinux,grub-efi"
BOOTAPPEND="boot=live components hostname=raidforge username=root ip=dhcp quiet"
if [ "$ARCH" != "amd64" ]; then
    BOOTLOADERS="grub-efi"
    # tty0 keeps the TUI on the BMC/KVM console; ttyAMA0 covers serial-only
    # access (QEMU virt, headless rack installs).
    BOOTAPPEND="$BOOTAPPEND console=tty0 console=ttyAMA0,115200n8"
fi

# Mirror actually reachable from the build network.  debootstrap, the build
# chroot and the runtime apt sources of the live image all point here so an
# offline-ish intranet build never waits on deb.debian.org.
MIRROR="${MIRROR:-http://mirrors.163.com/debian/}"
# security.debian.org is frequently throttled from CN networks; the 163 mirror
# carries the same bookworm-security repository and is ~10x faster here.
SECURITY="${SECURITY:-http://mirrors.163.com/debian-security/}"

lb config noauto \
    --mode debian \
    --distribution "${DISTRO}" \
    --architecture "${ARCH}" \
    --binary-images iso-hybrid \
    --bootloaders "${BOOTLOADERS}" \
    --archive-areas "main non-free-firmware" \
    --mirror-bootstrap "${MIRROR}" \
    --mirror-chroot "${MIRROR}" \
    --mirror-binary "${MIRROR}" \
    --mirror-chroot-security "${SECURITY}" \
    --mirror-binary-security "${SECURITY}" \
    --parent-mirror-binary "${MIRROR}" \
    --parent-mirror-chroot "${MIRROR}" \
    --parent-mirror-binary-security "${SECURITY}" \
    --parent-mirror-chroot-security "${SECURITY}" \
    --security true \
    --updates true \
    --backports false \
    --debian-installer none \
    --debian-installer-gui false \
    --win32-loader false \
    --apt-recommends false \
    --apt-indices false \
    --apt-source-archives false \
    --firmware-binary true \
    --firmware-chroot true \
    --initramfs live-boot \
    --system live \
    --zsync false \
    --checksums sha256 \
    --memtest none \
    --iso-volume "RAIDFORGE" \
    --bootappend-live "${BOOTAPPEND}" \
    "$@"
