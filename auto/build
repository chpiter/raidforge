#!/bin/sh
#
# Thin wrapper around `lb build` that injects build metadata into the image.
#
set -e

echo "raidforge build started: $(date -u +%Y-%m-%dT%H:%M:%SZ)" > build-start.stamp

lb build noauto "$@"

ISO="$(ls -1 live-image-*.hybrid.iso 2>/dev/null | head -n1 || true)"
if [ -n "${ISO}" ]; then
    echo "raidforge build finished: $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "${ISO}.buildinfo"
fi
