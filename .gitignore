## transient / generated
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

## live-build working tree
.cache/
chroot/
binary/
cache/
config/binary
config/bootstrap
config/chroot
config/common
config/source
.tmp/

## build outputs
*.iso
*.iso.sha256
*.img
*.contents
*.packages
*.hybrid.iso
*.buildinfo
build-start.stamp

## staged during build (copies of app/, wheels, drivers and vendor CLIs)
config/includes.chroot/usr/src/raidforge/
config/includes.chroot/usr/src/raidforge-vendor/
config/includes.chroot/usr/src/raidforge-drivers/
config/includes.chroot/etc/raidforge/agent.yaml
vendor/wheels/
# generated by tools/drivers.py on every build
config/package-lists/26-drivers.generated.list.chroot
vendor/drivers/selection.json

## vendor payloads: binaries and out-of-tree drivers are never committed
vendor/cli/
vendor/drivers/probes/
vendor/drivers/*/debs/
vendor/drivers/*/ko/
vendor/drivers/*/dkms/
vendor/drivers/*/firmware/

## shipped binaries - never commit, see README "Vendor tools"
config/includes.chroot/usr/local/bin/storcli
config/includes.chroot/usr/local/bin/storcli64
config/includes.chroot/usr/local/bin/arcconf
config/includes.chroot/usr/local/bin/ssacli
config/includes.chroot/usr/local/bin/hpssacli
config/includes.chroot/usr/local/bin/perccli
config/includes.chroot/usr/local/bin/perccli64
config/includes.chroot/usr/local/bin/megacli

## local evidence / keys
/var/log/raidforge-evidence
evidence-local/
*.pem
keys/
# the bare "keys/" pattern only matches the repo root, so name the shipped
# evidence-upload key explicitly - it must never be committed
config/includes.chroot/etc/raidforge/keys/

## tool output (tools/check.sh, chroot_tty.py, qemu_drive.py)
artifacts/

## webplane control plane: frontend deps / build output, local data
webplane/web/node_modules/
webplane/web/dist/
webplane-data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
webplane/**/__pycache__/

## debug helper credentials (tools/rssh.py)
tools/.remote.env
